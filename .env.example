APP_NAME="Inventory API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# PostgreSQL is required, not optional: the concurrency guarantees rely on
# real SELECT ... FOR UPDATE row locking.
#
# Running locally?    DB_HOST=127.0.0.1
# Running in Docker?  DB_HOST=postgres   (the compose service name)
#
# The test suite uses a SEPARATE database, `inventory_testing`, pinned in
# phpunit.xml. Create it before running tests:
#   createdb -U postgres inventory_testing
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=inventory
DB_USERNAME=postgres
DB_PASSWORD=

# --- Redis --------------------------------------------------------------
# Required. The queued listeners, the summary cache and the rate limiters all
# run through Redis, and phpredis (not predis) is the installed client.
#
# Running locally?    REDIS_HOST=127.0.0.1
# Running in Docker?  REDIS_HOST=redis   (the compose service name)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Overridden to `sync` by phpunit.xml so queued listeners run inline in tests.
# Leave unset here; production uses the real redis queue driver.
# REDIS_QUEUE_DRIVER=redis

# --- Drivers ------------------------------------------------------------
# These MUST be redis. The three ShouldQueue listeners (audit log, low-stock
# alert, cache invalidation) and the per-pair summary cache depend on it.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
