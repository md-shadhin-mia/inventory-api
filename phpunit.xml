<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <!-- Concurrency runs LAST: it uses DatabaseTruncation and commits
                 rows for real, which must not leak into RefreshDatabase tests. -->
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Concurrency</exclude>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Feature/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            These values apply when the variable is NOT already present in the
            real process environment.

            IMPORTANT, verified empirically: `force="true"` does NOT override a
            real environment variable here. If you run this suite in a shell (or
            a container) where DB_DATABASE / CACHE_STORE / QUEUE_CONNECTION are
            already exported, those win — and RefreshDatabase would then rebuild
            whatever database they point at.

            So when running inside the Docker stack you MUST pass the test values
            explicitly; see the "Running the tests" section of README.md:
              -e DB_DATABASE=inventory_testing -e CACHE_STORE=array
              -e QUEUE_CONNECTION=sync -e SESSION_DRIVER=array

            DB_HOST/DB_PORT are intentionally left plain so a container's
            DB_HOST=postgres is picked up without a second config file.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="inventory_testing" force="true"/>
        <env name="DB_USERNAME" value="postgres" force="true"/>
        <env name="DB_PASSWORD" value="12345678" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="REDIS_QUEUE_DRIVER" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
